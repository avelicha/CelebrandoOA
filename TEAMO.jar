public class Main {

    public static void main(String[] args) {
        String[] corazon = {
            "      ******       ******      ",
            "    **********   **********    ",
            "   ************* ************* ",
            "  *****************************",
            "  *****************************",
            "   *************************** ",
            "    *************************  ",
            "      *********************    ",
            "        *****************      ",
            "          *************        ",
            "            *********          ",
            "              *****            ",
            "                *              "
        };

        // Animación para dibujar el corazón
        for (String linea : corazon) {
            System.out.println(linea);
            pausa(150);
        }

        System.out.println();
        
        // Mensaje especial para Tavo
        String mensaje = "  Para mi Tavo: \n¡Eres una persona increíble y muy especial! Felices 2 meses mi amor,\nvamos por muchos muchos más, \nhan pasado super rapidisimo.\n Te AMOOOOOOOOO ! ❤️";
		 
        
        for (char c : mensaje.toCharArray()) {
            System.out.print(c);
            pausa(50);
        }
        
        System.out.println("\n");
    }

    private static void pausa(int milisegundos) {
        try {
            Thread.sleep(milisegundos);
        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
        }
    }
}
